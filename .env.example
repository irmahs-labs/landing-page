SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# The chat bot visitors ask about me, through OpenRouter (openrouter.ai/keys).
# OPENROUTER_MODEL is optional and defaults to openrouter/auto, the Auto Router.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# The account service the sign-in button talks to. Defaults to
# https://auth.irmahs.dev; for local development with irmahs-labs/auth running:
# NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# The visitor numbers in profile.txt, for an admin: a Cloudflare API token with
# Zone > Analytics > Read for irmahs.dev, and the zone's ID (its Overview page)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
